# Ejemplo de location para incorporar en el server de nginx.
# NO instalar sin comprobar seguridad, autenticación y puerto real.
server {
    listen 127.0.0.1:8080;
    server_name localhost;
    root /opt/epp/dashboard;
    index index.html;

    location / { try_files $uri $uri/ =404; }
    location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
# La API HTTP aún no existe. Mantener bind local hasta definir autenticación y acceso remoto.
